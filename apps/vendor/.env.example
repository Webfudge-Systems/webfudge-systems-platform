# Vendor portal — Webfudge staff view of every organization, subscription and payment.
# Point it at the API whose customers you want to see (normally the SaaS API).
NEXT_PUBLIC_API_URL=http://localhost:1338
# NEXT_PUBLIC_API_URL=https://api.webfudgesystems.in
NEXT_PUBLIC_VENDOR_APP_URL=http://localhost:3004

# Only accounts listed in PLATFORM_ADMIN_EMAILS on the API (comma-separated) can open the portal.
# Leave NEXT_PUBLIC_PLATFORM_MODE unset here: the portal signs in on its own login page.
