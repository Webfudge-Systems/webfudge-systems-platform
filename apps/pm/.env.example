# PM App — copy to .env.local for local development overrides

# ─── Option A: Local PM UI + production API (preview PM frontend against live data)
NEXT_PUBLIC_API_URL=https://api.webfudge.in
NEXT_PUBLIC_PM_APP_URL=http://localhost:3006
NEXT_PUBLIC_CRM_APP_URL=https://crm.webfudge.in

# ─── Option B: Full local stack (local backend on port 1338 + apps/backend/.env prod DB)
# NEXT_PUBLIC_API_URL=http://localhost:1338

# Default offline dev (SQLite backend)
# NEXT_PUBLIC_API_URL=http://localhost:1338
# NEXT_PUBLIC_CRM_APP_URL=http://localhost:3007

# ─── SaaS deployment (webfudgesystems.in) ──────────────────────────────────
# saas = sign-in through Webfudge Accounts, trial / plan banners and locks. Leave unset on Internal.
# NEXT_PUBLIC_PLATFORM_MODE=saas
# One sign-in across accounts., crm. and pm. (the cookie is shared on this parent domain).
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.webfudgesystems.in
# NEXT_PUBLIC_ACCOUNTS_APP_URL=https://accounts.webfudgesystems.in
# NEXT_PUBLIC_CRM_APP_URL=https://crm.webfudgesystems.in
# NEXT_PUBLIC_PM_APP_URL=https://pm.webfudgesystems.in
# NEXT_PUBLIC_SITE_URL=https://webfudgesystems.in
