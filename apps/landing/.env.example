# Landing frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:1337

# Production example (set in Vercel)
# NEXT_PUBLIC_API_URL=https://api.webfudge.in

# Site URL for canonical metadata, sitemap, and robots
# NEXT_PUBLIC_SITE_URL=https://webfudgesystems.in

# Contact form — inbox for submissions
CONTACT_TO_EMAIL=contact@webfudge.in

# Option A (recommended): Resend — sign up at https://resend.com, use API key from dashboard
# Free tier can send to your signup email via onboarding@resend.dev
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Webfudge Contact <onboarding@resend.dev>

# Option B: Gmail SMTP — App Password at https://myaccount.google.com/apppasswords
# GMAIL_USER=webfudgesystems@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# ─── SaaS website ───────────────────────────────────────────────────────────
# Sign-in / sign-up buttons go to Webfudge Accounts.
# NEXT_PUBLIC_ACCOUNTS_APP_URL=https://accounts.webfudgesystems.in
# Prices on the website are read from NEXT_PUBLIC_API_URL/api/saas/catalog (hourly), with defaults as fallback.
