{
  "kind": "collectionType",
  "collectionName": "invest_transactions",
  "info": {
    "singularName": "invest-transaction",
    "pluralName": "invest-transactions",
    "displayName": "Invest Transaction",
    "description": "Internal investment manager: a buy, sell, SIP instalment or dividend on an instrument."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": ["buy", "sell", "sip", "dividend"],
      "default": "buy",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "units": {
      "type": "float"
    },
    "price": {
      "type": "float"
    },
    "amount": {
      "type": "float"
    },
    "charges": {
      "type": "float",
      "default": 0
    },
    "account": {
      "type": "string"
    },
    "folio": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "autoGenerated": {
      "type": "boolean",
      "default": false
    },
    "instrument": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invest-instrument.invest-instrument"
    },
    "sip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invest-sip.invest-sip"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    },
    "createdByUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
