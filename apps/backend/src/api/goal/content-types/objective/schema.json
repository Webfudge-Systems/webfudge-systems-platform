{
  "kind": "collectionType",
  "collectionName": "goal_objectives",
  "info": {
    "singularName": "objective",
    "pluralName": "objectives",
    "displayName": "Goal Objective",
    "description": "Objective (OKR) with key results. Generic: shared by Fudge Work and, later, Fudge People (W12)"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "periodLabel": { "type": "string" },
    "startDate": { "type": "date" },
    "endDate": { "type": "date" },
    "status": { "type": "enumeration", "enum": ["active", "completed", "archived"], "default": "active" },
    "visibility": { "type": "enumeration", "enum": ["organization", "private"], "default": "organization" },
    "scope": { "type": "string", "default": "work" },
    "progress": { "type": "decimal", "default": 0 },
    "owner": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "createdByUser": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "parent": { "type": "relation", "relation": "manyToOne", "target": "api::goal.objective" },
    "keyResults": { "type": "relation", "relation": "oneToMany", "target": "api::goal.key-result", "mappedBy": "objective" },
    "organization": { "type": "relation", "relation": "manyToOne", "target": "api::organization.organization" }
  }
}
