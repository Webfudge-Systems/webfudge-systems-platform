{
  "kind": "collectionType",
  "collectionName": "crm_org_settings",
  "info": {
    "singularName": "crm-org-setting",
    "pluralName": "crm-org-settings",
    "displayName": "CRM Org Setting",
    "description": "Per-organization CRM settings stored as key + JSON value (lead SLA, picklists, notification preferences)"
  },
  "options": {
