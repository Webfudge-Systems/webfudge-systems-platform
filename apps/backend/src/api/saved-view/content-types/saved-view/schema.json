{
  "kind": "collectionType",
  "collectionName": "saved_views",
  "info": {
    "singularName": "saved-view",
    "pluralName": "saved-views",
    "displayName": "Saved View",
    "description": "A user's saved view (layout, grouping, columns, sort, filters) for a page such as a project, My Tasks or a Grow list; optionally shared with the org"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "scope": {
      "type": "string",
      "required": true
    },
    "config": {
      "type": "json"
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    },
    "shared": {
      "type": "boolean",
      "default": false
    }
  }
}
