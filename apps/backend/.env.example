HOST=0.0.0.0
PORT=1338
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Deployment ─────────────────────────────────────────────────────────────
# internal = Webfudge's own CRM/PM (default when unset) · saas = customer product
# The saas deployment refuses to start without JWT_SECRET. See docs/INTERNAL_AND_SAAS_DEPLOYMENTS.md
# PLATFORM_MODE=internal
# Comma-separated frontends allowed to call this API. Unset = built-in Webfudge allow-list.
# CORS_ORIGINS=https://crm.webfudgesystems.in,https://pm.webfudgesystems.in,https://accounts.webfudgesystems.in

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default — development only, NOT suitable for production SAAS)
DATABASE_CLIENT=sqlite

# PostgreSQL (recommended for production / multi-tenant SAAS)
# 1. Install the driver:  npm install pg  (in apps/backend)
# 2. Set DATABASE_CLIENT=postgres  and fill in the vars below.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=webfudge_platform
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_strong_password
# DATABASE_SSL=false
# Remote Postgres (e.g. Supabase): if Node errors on TLS chain, set DATABASE_SSL=true and try:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# (Prefer fixing CA trust / NODE_EXTRA_CA_CERTS in production.)
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# Or use a full connection string (e.g. on Supabase / Railway / Neon):
# DATABASE_URL=postgresql://postgres:password@db.host:5432/webfudge_platform
#
# Railway (link Postgres service → API service variables):
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=5
# SEED_DATA=false
# See docs/RAILWAY_STRAPI_DEPLOY.md

# ─── Seed data ──────────────────────────────────────────────────────────────
# Default apps (CRM, PM, Accounts) + modules seed automatically when the DB has
# no App entries. Set SEED_DATA=true to run the seed again (updates by slug).
# SEED_DATA=true

# ─── Redis (optional caching) ───────────────────────────────────────────────
# Railway: link Redis service → API variables get REDIS_URL automatically.
# Private URL (API ↔ Redis in same project): redis://default:pass@redis.railway.internal:6379
# Local dev: use Redis → Connect → public URL (internal host does not resolve on your PC).
# REDIS_URL=redis://default:password@switchback.proxy.rlwy.net:31548
# Or omit REDIS_URL and use Railway-injected REDISHOST + REDISPASSWORD.
# REDIS_ENABLED=false
# CACHE_API_ENABLED=true
# CACHE_TTL_SECONDS=300
# CACHE_MAX_BODY_BYTES=5242880
# CACHE_KEY_PREFIX=cache

# ─── Real Estate CRM webhooks ───────────────────────────────────────────────
# Shared secret for server-to-server calls from the Fudge Estate Next.js app
# to /api/re-webhooks/* (Meta lead ingestion + landing-page enrichment).
# Must match RE_WEBHOOK_SECRET in apps/real-estate-crm. Generate: openssl rand -hex 32
# RE_WEBHOOK_SECRET=

# ─── AWS S3 (file uploads via Strapi) ───────────────────────────────────────
# Bucket should use ACLs disabled; do not set AWS_ACL (access via signed URLs or CDN).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=webfudge-uploads-prod
# CDN_URL=https://your-cloudfront-domain.cloudfront.net
# CDN_ROOT_PATH=
# PUBLIC_URL=https://api.webfudge.in

# ─── SaaS (PLATFORM_MODE=saas only) ─────────────────────────────────────────
# Webfudge Accounts URL: invitation links and billing links in emails point here.
# ACCOUNTS_URL=https://accounts.webfudgesystems.in

# Transactional email (sign-up codes, password reset, invitations, receipts, trial reminders).
# Without RESEND_API_KEY nothing is sent (codes are printed to the console outside production).
# RESEND_API_KEY=
# MAIL_FROM=Webfudge <no-reply@webfudgesystems.in>
# MAIL_REPLY_TO=contact@webfudge.in

# Razorpay — billing stays "coming soon" until the key id and secret are set.
# Dashboard → Settings → API Keys. Use rzp_test_… keys first.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://api.webfudgesystems.in/api/billing/webhook,
# events: order.paid, payment.captured, payment.failed. Paste the webhook secret here.
# RAZORPAY_WEBHOOK_SECRET=

# Invoice details (seller side). Confirm the SAC code with your CA.
# BILLING_SELLER_NAME=Webfudge Systems
# BILLING_SELLER_GSTIN=
# BILLING_SELLER_ADDRESS=Pune, Maharashtra, India
# BILLING_SELLER_STATE=Maharashtra
# BILLING_SELLER_EMAIL=billing@webfudgesystems.in
# BILLING_SAC_CODE=
# BILLING_GST_RATE=0.18
