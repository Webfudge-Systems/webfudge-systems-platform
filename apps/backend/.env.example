HOST=0.0.0.0
PORT=1338
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Deployment ─────────────────────────────────────────────────────────────
# internal = Webfudge's own CRM/PM (default when unset) · saas = customer product
# The saas deployment refuses to start without JWT_SECRET. See docs/INTERNAL_AND_SAAS_DEPLOYMENTS.md
# PLATFORM_MODE=internal
# Comma-separated frontends allowed to call this API. Unset = built-in Webfudge allow-list.
# CORS_ORIGINS=https://crm.webfudgesystems.in,https://pm.webfudgesystems.in,https://accounts.webfudgesystems.in

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default — development only, NOT suitable for production SAAS)
DATABASE_CLIENT=sqlite

# PostgreSQL (recommended for production / multi-tenant SAAS)
# 1. Install the driver:  npm install pg  (in apps/backend)
# 2. Set DATABASE_CLIENT=postgres  and fill in the vars below.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=webfudge_platform
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_strong_password
# DATABASE_SSL=false
# Remote Postgres (e.g. Supabase): if Node errors on TLS chain, set DATABASE_SSL=true and try:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# (Prefer fixing CA trust / NODE_EXTRA_CA_CERTS in production.)
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# Or use a full connection string (e.g. on Supabase / Railway / Neon):
# DATABASE_URL=postgresql://postgres:password@db.host:5432/webfudge_platform
#
# Railway (link Postgres service → API service variables):
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=5
# SEED_DATA=false
# See docs/RAILWAY_STRAPI_DEPLOY.md

# ─── Seed data ──────────────────────────────────────────────────────────────
# Default apps (CRM, PM, Accounts) + modules seed automatically when the DB has
# no App entries. Set SEED_DATA=true to run the seed again (updates by slug).
# SEED_DATA=true

# ─── Redis (optional caching) ───────────────────────────────────────────────
# Railway: link Redis service → API variables get REDIS_URL automatically.
# Private URL (API ↔ Redis in same project): redis://default:pass@redis.railway.internal:6379
# Local dev: use Redis → Connect → public URL (internal host does not resolve on your PC).
# REDIS_URL=redis://default:password@switchback.proxy.rlwy.net:31548
# Or omit REDIS_URL and use Railway-injected REDISHOST + REDISPASSWORD.
# REDIS_ENABLED=false
# CACHE_API_ENABLED=true
# CACHE_TTL_SECONDS=300
# CACHE_MAX_BODY_BYTES=5242880
# CACHE_KEY_PREFIX=cache

# ─── Meta Lead Ads capture (Grow, PLATFORM_MODE=saas only) ──────────────────
# Facebook / Instagram lead forms → Grow lead companies. See docs/SAAS_PLATFORM.md
# ("Meta Lead Ads capture") for the Meta app setup. The Settings page shows
# "not switched on yet" until the first five are set.
# Meta app → Settings → Basic: App ID and App secret (the secret also signs webhooks).
# META_APP_ID=
# META_APP_SECRET=
# Any random string; paste the same value as the Verify token in Meta → Webhooks → Page.
# META_WEBHOOK_VERIFY_TOKEN=
# Encrypts stored Facebook tokens. Generate: openssl rand -hex 32. Changing it forces every org to reconnect.
# META_TOKEN_ENCRYPTION_KEY=
# OAuth redirect (must be listed in Facebook Login → Valid OAuth redirect URIs).
# Defaults to ${PUBLIC_URL}/api/crm-meta/oauth/callback when unset.
# META_OAUTH_REDIRECT_URI=https://api.webfudgesystems.in/api/crm-meta/oauth/callback
# Grow (CRM) URL: where people land after connecting Facebook.
# CRM_APP_URL=https://crm.webfudgesystems.in
# Optional: Graph API version (default v25.0).
# META_GRAPH_VERSION=
# Test only (mock Graph server in scripts/test-meta-lead-ads-e2e.js). Never set in a real deployment.
# META_GRAPH_BASE_URL=

# ─── AWS S3 (file uploads via Strapi) ───────────────────────────────────────
# Bucket should use ACLs disabled; do not set AWS_ACL (access via signed URLs or CDN).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=webfudge-uploads-prod
# CDN_URL=https://your-cloudfront-domain.cloudfront.net
# CDN_ROOT_PATH=
# PUBLIC_URL=https://api.webfudge.in

# ─── SaaS (PLATFORM_MODE=saas only) ─────────────────────────────────────────
# Webfudge Accounts URL: invitation links and billing links in emails point here.
# ACCOUNTS_URL=https://accounts.webfudgesystems.in

# Transactional email (sign-up codes, password reset, invitations, receipts, trial reminders).
# Without RESEND_API_KEY nothing is sent (codes are printed to the console outside production).
# RESEND_API_KEY=
# MAIL_FROM=Webfudge <no-reply@webfudgesystems.in>
# MAIL_REPLY_TO=contact@webfudge.in

# Razorpay — billing stays "coming soon" until the key id and secret are set.
# Dashboard → Settings → API Keys. Use rzp_test_… keys first.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://api.webfudgesystems.in/api/billing/webhook,
# events: order.paid, payment.captured, payment.failed. Paste the webhook secret here.
# RAZORPAY_WEBHOOK_SECRET=

# Invoice details (seller side). Confirm the SAC code with your CA.
# BILLING_SELLER_NAME=Webfudge Systems
# BILLING_SELLER_GSTIN=
# BILLING_SELLER_ADDRESS=Pune, Maharashtra, India
# BILLING_SELLER_STATE=Maharashtra
# BILLING_SELLER_EMAIL=billing@webfudgesystems.in
# BILLING_SAC_CODE=
# BILLING_GST_RATE=0.18

# Vendor portal (apps/vendor): Webfudge staff emails allowed to see every organization,
# subscription, payment and user, and to extend trials or suspend organizations. Comma-separated.
# Unset = nobody can open the portal.
# PLATFORM_ADMIN_EMAILS=you@webfudge.in,ops@webfudge.in

# Client portal (W10): magic links point at <PORTAL_APP_URL>/portal/auth. The portal lives in the
# Work app, so this is the Work (PM) frontend URL. Default http://localhost:3006.
# PORTAL_APP_URL=https://pm.webfudgesystems.in

# ─── Fudge AI (P5, PLATFORM_MODE=saas only) ─────────────────────────────────
# Server-side only: these never reach a browser. See docs/AI_PLATFORM.md.
# AI stays off unless AI_ENABLED=true (and is always off on the Internal deployment).
# AI_ENABLED=false
# Provider: anthropic (default) or mock (scripted answers for local end-to-end runs, no key needed)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Model per tier (defaults shown). cheap = classify/extract/score, strong = drafting/reasoning, premium = opt-in.
# AI_MODEL_CHEAP=claude-haiku-5-5
# AI_MODEL_STRONG=claude-sonnet-5-5
# AI_MODEL_PREMIUM=claude-opus-5-5
# Per-attempt timeout and retries for retryable errors (429 / 5xx / network)
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# Server-side refusal fallback on Sonnet/Opus 5.5 (on by default)
# AI_REFUSAL_FALLBACK=on
# Credits: 1 credit = AI_CREDIT_USD of model cost, rounded up, at least AI_MIN_CREDITS_PER_CALL per call.
# The monthly allowance comes from each plan's aiCreditsMonthly (Strapi admin → Plan). Months follow AI_CREDIT_TIMEZONE.
# AI_CREDIT_USD=0.01
# AI_MIN_CREDITS_PER_CALL=1
# AI_CREDIT_TIMEZONE=Asia/Kolkata
# Price for a model not in the built-in list (USD per million tokens)
# AI_PRICE_IN_PER_MTOK=
# AI_PRICE_OUT_PER_MTOK=
# Business memory embeddings. Chosen vendor: Voyage AI (set voyage + VOYAGE_API_KEY in production).
# Unset = hash (local, free, lexical only). After switching, memory refills as records are re-indexed.
# AI_EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=
# AI_EMBEDDINGS_MODEL=voyage-3.5-lite
# pgvector is used automatically on Postgres when the "vector" extension is installed; off forces the fallback
# AI_MEMORY_PGVECTOR=auto
# AI_MEMORY_SCAN_LIMIT=5000
# Voice-note transcription. Chosen vendor: OpenAI Whisper (whisper + OPENAI_API_KEY). none = off (default), stub = fixed text.
# AI_TRANSCRIPTION_PROVIDER=whisper
# OPENAI_API_KEY=
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_TRANSCRIPTION_TIMEOUT_MS=120000
# Cost per audio minute used for credits (Whisper list price)
# AI_TRANSCRIPTION_USD_PER_MIN=0.006
